         return True  # TODO: maybe need try error
 
+    def _eval_video_frame(self):
+        # local patch: ROBOTWIN_EVAL_VIDEO_GRID=1 records a 2x2 grid (third view | head / left wrist | right wrist)
+        # instead of the third view alone; eval_policy_xpolicylab.py doubles video_size to match
+        third = self.now_obs["third_view_rgb"]
+        if os.environ.get("ROBOTWIN_EVAL_VIDEO_GRID") != "1":
+            return third
+        obs = self.now_obs["observation"]
+        tiles = [third] + [obs[c]["rgb"] for c in ("head_camera", "left_camera", "right_camera")]
+        h, w = third.shape[:2]
+        if any(t.shape[:2] != (h, w) for t in tiles):
+            import cv2
+            tiles = [t if t.shape[:2] == (h, w) else cv2.resize(t, (w, h), interpolation=cv2.INTER_AREA) for t in tiles]
+        return np.ascontiguousarray(np.concatenate([np.concatenate(tiles[:2], 1), np.concatenate(tiles[2:], 1)], 0))
+
